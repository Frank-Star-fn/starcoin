# ============================================================
# StarCoin 配置模板
# 复制此文件为 .env 并按需修改：
#   cp .env.example .env
# ============================================================

# -------- 节点配置 --------
PORT=3000                                          # HTTP/WS 服务端口
HOST=127.0.0.1                                     # 默认只监听本机；公网服务需显式配置
ADMIN_TOKEN=                                      # 管理凭证，留空禁用管理操作；请使用随机长字符串
LEGACY_WALLET_API=false                           # 旧私钥/助记词接口默认关闭；true 也仅允许本机直连并需管理凭证
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]         # 允许的 Host 主机名，公网部署添加实际域名
TRUSTED_PROXIES=                                  # 默认不信任代理；填写具体代理 IP/CIDR，禁止 true 或任意跳数
MINING_MAX_STREAMS=8                               # 最大同时挖矿进度连接数
SEED_PEERS=                                        # 种子节点列表（逗号分隔，如 "ws://localhost:3000,ws://localhost:3001"）
# NODE_NAME=                                       # 自定义节点名称（可选，默认自动生成）

# -------- EVM 网络（升级前停止全部节点，运行 npm run evm:prepare） --------
EVM_CHAIN_ID=155001                               # 数字 chainId；首次准备后固定在 data/evm-network.json
# 同一网络所有节点共用 evm-network.json 和 metamask-network.json（跨机器需复制）。保留原生 CHAIN_ID 和历史共识参数。
# 已有 EVM 网络：停止全部节点后运行 npm run metamask:prepare，再重启全部节点。
# 固定 Shanghai；默认每块 30000000 Gas、每交易 5000000 Gas。
# 历史 v3 固定 10 gwei；v4 baseFee 从 10 gwei 按 EIP-1559 调整，建议优先费 1 gwei。

# -------- P2P 重连配置 --------
P2P_RECONNECT_BASE_DELAY=1000                      # 重连初始延迟（毫秒）
P2P_RECONNECT_MAX_DELAY=30000                      # 重连最大延迟（毫秒）
P2P_RECONNECT_MAX_RETRIES=50                       # 最大重试次数
P2P_RECONNECT_JITTER=0.3                           # 随机抖动系数（0~1）

# -------- P2P 心跳配置 --------
P2P_HEARTBEAT_INTERVAL=15000                       # 心跳发送间隔（毫秒）
P2P_HEARTBEAT_TIMEOUT=6000                         # 心跳超时阈值（毫秒）

# -------- 节点发现配置 --------
P2P_DISCOVERY_INTERVAL=30000                       # 自动发现请求间隔（毫秒）
P2P_DISCOVERY_MAX_PEERS=20                         # 最大对等节点数
P2P_DISCOVERY_MAX_PER_ROUND=3                      # 每轮最大尝试连接数
P2P_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]         # 允许连接及自动发现的主机名；跨机器添加实际主机
P2P_MAX_PAYLOAD=4194304                            # 单条 P2P 消息最大字节数
P2P_MAX_CHAIN_BLOCKS=10000                         # 同步消息最大区块数（本地接收策略）
P2P_MAX_TRANSACTIONS=1000                          # 单条消息最大交易数
P2P_MAX_MESSAGES=120                               # 每连接每十秒最大消息数
P2P_MAX_CONNECTIONS=32                            # 最大 WS 连接数（含前端订阅）

# -------- 链同步配置 --------
SYNC_TIMEOUT=10000                                 # 同步响应超时（毫秒）
SYNC_INTERVAL=60000                                # 定期自动同步间隔（毫秒）
SYNC_HEALTH_CHECK_INTERVAL=30000                   # 链健康检查间隔（毫秒）
SYNC_STARTUP_CONNECT_DELAY=1500                    # 启动后首次连接延迟（毫秒）

# -------- 挖矿/区块配置 --------
MINING_REWARD=50                                   # 矿工奖励金额
CHAIN_ID=starcoin-main-v2                          # 共识链标识，所有节点一致
PROTOCOL_ACTIVATION_HEIGHT=1                      # v2 激活高度；旧链先运行审计工具
LEGACY_CHECKPOINT_HASH=                           # 激活高度>1时必填前一块的审计后哈希
MAX_FUTURE_BLOCK_SECONDS=120                      # 区块允许的未来时间偏移
PAYMENT_CONFIRMATIONS=6                          # 收款确认阈值（本地策略）
DEEP_REORG_THRESHOLD=6                           # 深度重组告警阈值（本地策略）
MINING_COINBASE_MATURITY=5                         # 矿工奖励锁定期（区块数）
MINING_MAX_TXS_PER_BLOCK=100                       # 每区块最大打包交易数

# -------- 难度调整配置 --------
DIFFICULTY_INITIAL=5                               # 初始难度
DIFFICULTY_TARGET_TIME=12                          # 目标出块时间（秒）
DIFFICULTY_ADJUST_INTERVAL=6                       # 每 N 个区块调整一次
DIFFICULTY_MIN=3                                   # 最小难度
DIFFICULTY_MAX=12                                  # 最大难度
DIFFICULTY_STEP=0.1                                # 调整步长

# -------- 日志配置 --------
# LOG_LEVEL=info                                    # 日志级别：debug / info / warn / error
# LOG_TRANSPORT=console                             # 输出目标：console / file / both
# LOG_DIR=./logs                                    # 日志文件目录
# LOG_FILE_MAX_SIZE=10485760                        # 单个日志文件最大字节数（10MB）
# LOG_FILE_MAX_FILES=5                              # 保留的日志文件数量
# LOG_JSON=false                                    # 文件日志是否使用 JSON 格式

# -------- API 限流配置 --------
RATE_LIMIT_GLOBAL_WINDOW_MS=60000                  # 全局限流窗口（毫秒）
RATE_LIMIT_GLOBAL_MAX=600                           # 全局最大请求数 / 窗口
RATE_LIMIT_WRITE_WINDOW_MS=60000                   # 写操作限流窗口（毫秒）
RATE_LIMIT_WRITE_MAX=100                            # 写操作最大请求数 / 窗口
RATE_LIMIT_SEARCH_WINDOW_MS=60000                  # 搜索限流窗口（毫秒）
RATE_LIMIT_SEARCH_MAX=200                           # 搜索最大请求数 / 窗口
