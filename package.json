{
  "name": "starcoin",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "tsx src/server.js",
    "start:node1": "set PORT=3000 && tsx src/server.js",
    "start:node2": "set PORT=3001 && tsx src/server.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start:prod": "node dist/src/server.js",
    "start:prod:node1": "set PORT=3000 && node dist/src/server.js",
    "start:prod:node2": "set PORT=3001 && node dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:build": "node scripts/compile-contracts.js",
    "evm:prepare": "node scripts/prepare-evm.js",
    "metamask:prepare": "node scripts/prepare-metamask.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@ethereumjs/binarytree": "10.1.0",
    "@ethereumjs/block": "10.1.0",
    "@ethereumjs/common": "10.1.0",
    "@ethereumjs/evm": "10.1.0",
    "@ethereumjs/mpt": "10.1.0",
    "@ethereumjs/rlp": "10.1.0",
    "@ethereumjs/statemanager": "10.1.0",
    "@ethereumjs/tx": "10.1.0",
    "@ethereumjs/util": "10.1.0",
    "@ethereumjs/vm": "10.1.0",
    "bip32": "5.0.1",
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "ethers": "6.17.0",
    "express": "4.22.3",
    "tiny-secp256k1": "2.2.4",
    "ws": "8.21.0"
  },
  "overrides": {
    "@ethereumjs/util": "$@ethereumjs/util",
    "@ethereumjs/rlp": "$@ethereumjs/rlp",
    "ws": "$ws",
    "tmp": "0.2.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/ws": "^8.18.1",
    "solc": "0.8.30",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  }
}
